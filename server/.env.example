# ===== Agentar 记忆平台 · 服务端环境变量 =====

# LLM/embedder 密钥（私有化部署可填本地或专有云服务的 key）
OPENAI_API_KEY=

# 其他内置 LLM/embedder 供应商（按需填写）
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- 应用关系库（MySQL 8 / PostgreSQL 可切换） ----
# APP_DB_BACKEND: postgres（默认）| mysql（MySQL 8 兼容）
APP_DB_BACKEND=postgres
# 通用连接变量（优先级高于各后端默认变量）
# APP_DB_HOST=
# APP_DB_PORT=
# APP_DB_USER=
# APP_DB_PASSWORD=
# APP_DB_NAME=agentar_mem_app
# 所有业务表统一使用该前缀
APP_TABLE_PREFIX=agentar_mem_app_

# PostgreSQL 专有变量（APP_DB_BACKEND=postgres 时生效）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_DB_NAME=mem0_app

# MySQL 8 专有变量（APP_DB_BACKEND=mysql 时生效）
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=agentar
# MYSQL_PASSWORD=
# MYSQL_DATABASE=agentar_mem_app

# ---- 向量库（pgvector） ----
POSTGRES_DB=postgres
POSTGRES_COLLECTION_NAME=agentar_mem0

# ---- 认证 ----
ADMIN_API_KEY=
JWT_SECRET=
# 仅本地开发使用，生产环境保持 false
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000

# ---- 模型默认值（供应商需在 server/main.py 的 BUNDLED_*_PROVIDERS 内） ----
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# ---- 遥测（私有化版本默认关闭，不出网） ----
MEM0_TELEMETRY=false

# ---- 请求日志保留天数（make prune-logs 使用，生产环境接入 cron/systemd） ----
REQUEST_LOG_RETENTION_DAYS=30

# ---- 运行时 ----
# FastAPI worker 数（uvicorn --workers）
MEM0_WORKERS=1
# 日志目录（默认为项目同级目录下的 logs/），按天滚动，保留 LOG_BACKUP_COUNT 天
# LOG_DIR=
LOG_BACKUP_COUNT=14

# ---- 百炼（DashScope）模型：设置 DASHSCOPE_API_KEY 后启用 ----
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MEM0_DEFAULT_LLM_MODEL=qwen-plus-latest
# MEM0_DEFAULT_EMBEDDER_MODEL=qwen3.7-text-embedding
# MEM0_DEFAULT_RERANKER_MODEL=gte-rerank-v2
# MEM0_EMBEDDING_DIMS=1024

# ---- Vector projection tier (design §3.2) ----
# VECTOR_STORE_PROVIDER=elasticsearch        # elasticsearch | pgvector
# ES_HOST=elasticsearch
# ES_PORT=9200
# ES_USER=elastic
# ES_PASSWORD=change-me                      # required by adapter even on security-disabled dev nodes
# ES_COLLECTION_NAME=agentar_mem0
# ES_USE_SSL=false
# MEM0_DEFAULT_RERANKER_MODEL=qwen3-vl-rerank
